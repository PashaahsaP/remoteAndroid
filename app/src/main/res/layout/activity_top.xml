<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="75dp"
    android:background="@color/regularBlue"


    >

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:text="Back"
        android:textColor="@android:color/white"
        app:backgroundTint="@android:color/holo_red_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone"
        app:elevation="100dp"
        android:elevation="8dp"/>

    <Button
        android:id="@+id/btnTest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="some"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/searchImage" />
    <ImageButton
        android:id="@+id/threeDotImage"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@null"
        android:src="@drawable/threedostreal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/searchImage"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginRight="10dp"

        android:background="@null"
        android:src="@drawable/loupe_search_svgrepo_com"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/threeDotImage" />


</androidx.constraintlayout.widget.ConstraintLayout>